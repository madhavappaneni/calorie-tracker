# Frontend config. Vite only exposes vars prefixed with VITE_ to the browser bundle.
# Both of these are public by design (see spec §5): the publishable key grants nothing
# on its own — every request is filtered by Row Level Security against the user's JWT.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# The Supabase SECRET key and any GitHub PAT do NOT belong in this repo.
# They live only in the private calorie-tracker-backup repo's Actions secrets (spec §2, §8).
